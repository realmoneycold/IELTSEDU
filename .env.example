# ═══════════════════════════════════════════════════════════
# IELTSPRACTICE — Render.com + Neon.tech Environment Variables
#
# Copy these keys into your Render service dashboard under
# "Environment Variables". Do NOT commit real values to git.
# ═══════════════════════════════════════════════════════════

# ─── Database (Neon.tech) ──────────────────────────────────
# From your Neon project dashboard → Connection Details
#
# DATABASE_URL: use the *pooled* connection string (for app runtime via PgBouncer)
DATABASE_URL="postgresql://<user>:<password>@<pooled-host>.neon.tech/<dbname>?sslmode=require"

# DIRECT_URL: use the *direct/unpooled* connection string (for prisma migrate deploy)
DIRECT_URL="postgresql://<user>:<password>@<direct-host>.neon.tech/<dbname>?sslmode=require"

# ─── API URL (Frontend reference) ─────────────────────────
# Your live Render API URL — used by any standalone frontend (Vercel etc.)
# For plain HTML pages, this is baked in via runtime detection.
# For a Next.js / React frontend, set this as NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_API_URL="https://ieltspractice-api.onrender.com"

# ─── Server ────────────────────────────────────────────────
# Render assigns port 10000 internally — do not change this
PORT=10000
NODE_ENV="production"

# ─── CORS / Frontend ───────────────────────────────────────
# Your Vercel deployment URL. Multiple URLs are supported —
# separate with a space or comma.
# Example: "https://ieltspractice.vercel.app https://ieltspractice.net"
FRONTEND_URL="https://your-app.vercel.app"

# ─── Authentication ────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="generate-a-64-char-hex-string-here"

# ─── Email (Resend) ────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="IELTS Practice <noreply@ieltspractice.net>"

# ─── AI Services ───────────────────────────────────────────
GEMINI_API_KEY="your-gemini-api-key"
GROQ_API_KEY="gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ─── Monitoring (optional) ─────────────────────────────────
SENTRY_DSN="https://xxx@oxx.ingest.sentry.io/xxx"
