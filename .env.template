# ═══════════════════════════════════════════════════════════
# IELTSPRACTICE — Environment Variables Template
# Copy this file to .env and replace with actual secure values
# ═══════════════════════════════════════════════════════════

# ─── Database ──────────────────────────────────────────────
# Local development (PostgreSQL):
#   DATABASE_URL="postgresql://username:password@localhost:5432/ieltspractice"
#
# Production (Neon.tech serverless — copy the "pooled" connection string):
#   DATABASE_URL="postgresql://username:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgresql://username:password@host:port/database?sslmode=require"

# Neon.tech: set DIRECT_URL to the non-pooled connection string for Prisma migrations.
# For local dev, set this to the same value as DATABASE_URL.
DIRECT_URL="postgresql://username:password@host:port/database?sslmode=require"

# ─── Authentication ────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-super-secure-jwt-secret-min-64-chars-here"

# ─── Email Service (Resend) ────────────────────────────────
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="IELTS Practice <noreply@ieltspractice.net>"

# ─── Google OAuth ──────────────────────────────────────────
# Get from Google Cloud Console → APIs & Services → Credentials
# Authorized redirect URI must include: https://ieltspractice.net/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ─── Telegram Bot ──────────────────────────────────────────
# Get from @BotFather on Telegram
# Required for Telegram widget login hash verification
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"

# ─── Frontend URL ──────────────────────────────────────────
# Used for email links (password reset, verification) and CORS allowed origins.
# In production, set this to your domain.
FRONTEND_URL="https://ieltspractice.net"

# ─── Google Gemini AI ──────────────────────────────────────
GEMINI_API_KEY="your-actual-gemini-api-key-here"

# ─── Groq AI ───────────────────────────────────────────────
# Get your API key at https://console.groq.com/keys
# Used for IELTS writing assessment and AI mentoring
GROQ_API_KEY="gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ─── Server ────────────────────────────────────────────────
PORT=4000
NODE_ENV="production"
LOG_LEVEL="info"

# ─── API URL (used for OAuth callback URLs) ───────────────
# Set this to your backend domain in production:
API_URL="https://ieltspractice.net"

# ─── CORS Configuration ───────────────────────────────────
CORS_ORIGIN="https://ieltspractice.net"

# ─── Monitoring (Optional) ────────────────────────────────
SENTRY_DSN="your-sentry-dsn-here"

# ─── Cloudflare R2 Storage (Optional — future) ────────────
# CLOUDFLARE_R2_ACCESS_KEY="your-r2-access-key"
# CLOUDFLARE_R2_SECRET_KEY="your-r2-secret-key"
# CLOUDFLARE_R2_BUCKET="your-bucket-name"
# CLOUDFLARE_R2_ACCOUNT_ID="your-account-id"
